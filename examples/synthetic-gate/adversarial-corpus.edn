;; Independent expected-results corpus for spec 0005 T7 (adversarial
;; and boundary tests).
;;
;; This file specifies the EXPECTED outcomes of the named bypass
;; classes before (and independently of) the implementation that
;; satisfies them: each case names its bypass class, its inputs and
;; the exact expected admission outcome. The test interpreter
;; (test/axiom/gate_adversarial_test.clj) resolves the "SHA:*" /
;; "DIGEST:*" symbols to fixed synthetic values mechanically and
;; performs no expectation-shaping of its own.
;;
;; Symbol table (mechanical only):
;;   "SHA:base"  -> 40 x "b"      "SHA:head"  -> 40 x "c"
;;   "SHA:tree"  -> 40 x "d"      "SHA:stale" -> 40 x "e"
;;   "SHA:other" -> 40 x "f"
;;   "DIGEST:a"  -> "sha256:" + 64 x "a"
;;   "DIGEST:b"  -> "sha256:" + 64 x "b"
;; Every repository, SHA, login and workflow is invented (`synth-*`).

{:corpus/id "0005-adversarial-corpus"
 :corpus/policy
 {:policy/id "synth-enforce-v1"
  :policy/digest "DIGEST:a"
  :policy/approval-event-id "evt-approve-1"
  :policy/reserved-paths ["policies/"]
  :policy/gates [{:gate/id :ci
                  :gate/check-run-id 9001
                  :gate/workflow-identity ".github/workflows/synth-ci.yml"
                  :gate/required true}
                 {:gate/id :lint
                  :gate/check-run-id 9002
                  :gate/workflow-identity ".github/workflows/synth-lint.yml"
                  :gate/required true}]}

 :corpus/observation
 {:observation/repo "synth-org/synth-repo"
  :observation/pr 7
  :observation/base "SHA:base"
  :observation/head "SHA:head"
  :observation/tree "SHA:tree"
  :observation/changed-files ["src/synth.clj"]
  :observation/check-runs
  [{:check/id 9001
    :check/workflow-identity ".github/workflows/synth-ci.yml"
    :check/title "synth-ci / build"
    :check/conclusion :success
    :check/base "SHA:base"
    :check/head "SHA:head"
    :check/trust :trust/provider-authenticated}
   {:check/id 9002
    :check/workflow-identity ".github/workflows/synth-lint.yml"
    :check/title "synth-lint / check"
    :check/conclusion :success
    :check/base "SHA:base"
    :check/head "SHA:head"
    :check/trust :trust/provider-authenticated}]
  :observation/current? true
  :observation/synthetic-fixture? true
  :observation/trust :trust/provider-authenticated}

 :corpus/capability
 {:capability/mode :advisory
  :capability/trusted-evaluator "synth-evaluator"
  :capability/checks-write? false
  :capability/protection-readable? true
  :capability/protections-configurable? false
  :capability/advisory-reasons [:no-checks-write :protections-unconfigurable]}

 :corpus/decision
 {:gate/decision :allow
  :gate/reasons [{:gate/id :ci
                  :check/id 9001
                  :check/workflow-identity ".github/workflows/synth-ci.yml"
                  :gate/outcome :satisfied
                  :gate/reason :check-satisfied}
                 {:gate/id :lint
                  :check/id 9002
                  :check/workflow-identity ".github/workflows/synth-lint.yml"
                  :gate/outcome :satisfied
                  :gate/reason :check-satisfied}]
  :gate/candidate {:candidate/repo "synth-org/synth-repo"
                   :candidate/pr 7
                   :candidate/base "SHA:base"
                   :candidate/head "SHA:head"
                   :candidate/tree "SHA:tree"}
  :gate/evaluator "synth-evaluator"
  :gate/policy {:policy/id "synth-enforce-v1"
                :policy/digest "DIGEST:a"
                :policy/approval-event-id "evt-approve-1"}
  :gate/trust #{:trust/provider-authenticated}}

 :corpus/candidate
 {:candidate/repo "synth-org/synth-repo"
  :candidate/pr 7
  :candidate/base "SHA:base"
  :candidate/head "SHA:head"
  :candidate/tree "SHA:tree"}

 :corpus/cases
 [;; -- policy edit in the candidate (R4a) -------------------------
  {:case/id "policy-edit-in-candidate"
   :case/class :policy-edit
   :case/layer :gate
   :case/evaluator "synth-evaluator"
   :case/observation-patch
   {:observation/changed-files ["policies/enforce.edn" "src/synth.clj"]}
   :case/expected {:gate/decision :deny
                   :gate/reason :policy-path-touched-by-candidate}}

  ;; -- candidate bytes must not reach policy loading (R3) ----------
  {:case/id "candidate-relaxed-policy-bytes-ignored"
   :case/class :quarantine-violation
   :case/layer :gate
   :case/evaluator "synth-evaluator"
   :case/observation-patch
   {:observation/candidate-policy
    {:policy/id "synth-enforce-v1" :policy/gates []}
    ;; One required check is absent, so the approved policy — not the
    ;; smuggled relaxed bytes — yields defer: the quarantine holds and
    ;; a bypass-class case never expects allow.
    :observation/check-runs
    [{:check/id 9001
      :check/workflow-identity ".github/workflows/synth-ci.yml"
      :check/title "synth-ci / build"
      :check/conclusion :success
      :check/base "SHA:base"
